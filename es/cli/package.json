{
  "name": "agentic-gate-cli",
  "version": "0.1.0",
  "description": "Project-wide JavaScript and TypeScript quality gates for coding agents.",
  "type": "module",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/johnsonlee/agentic-gate.git",
    "directory": "es/cli"
  },
  "publishConfig": {
    "access": "public"
  },
  "bin": {
    "agentic-gate-cli": "./dist/agentic-gate-cli"
  },
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "README.md"
  ],
  "license": "Apache-2.0",
  "engines": {
    "bun": ">=1.3.0"
  },
  "os": [
    "linux"
  ],
  "cpu": [
    "x64"
  ],
  "libc": [
    "glibc"
  ],
  "scripts": {
    "clean": "bun -e \"import { rm } from 'node:fs/promises'; await rm('dist', { recursive: true, force: true })\"",
    "build": "bun run clean && bun --bun tsc --project tsconfig.build.json && bun ./build.ts",
    "typecheck": "bun --bun tsc --project tsconfig.json --noEmit",
    "test": "bun test",
    "test:dist": "bun ./smoke/dist.mjs",
    "check": "bun run typecheck && bun run test && bun run build && bun run test:dist",
    "prepack": "bun run check"
  },
  "dependencies": {
    "agentic-gate-engine": "workspace:*",
    "agentic-gate-rules": "workspace:*"
  },
  "devDependencies": {
    "@types/bun": "1.4.3",
    "typescript": "~6.0.3"
  }
}
